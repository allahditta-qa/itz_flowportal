  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:auth": "playwright test --project=auth",
    "test:login": "playwright test tests/auth/login.spec.ts",
    "test:signout": "playwright test tests/auth/signout.spec.ts",
    "test:theme": "playwright test tests/theme",
    "test:workspace": "playwright test tests/workspace",
    "test:project": "playwright test tests/project",
    "test:my-work": "playwright test tests/my-work",
    "reports": "start \"\" reports\\index.html",
    "cases:csv": "node scripts/export-test-cases.js",
    "cases:check": "node scripts/export-test-cases.js --check",
    "typecheck": "tsc --noEmit -p .",
    "test:smoke": "node scripts/run-regression.js --priority High",
    "test:regression": "node scripts/run-regression.js",
    "module:new": "node scripts/new-module.js",
    "signoff": "node scripts/signoff.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
