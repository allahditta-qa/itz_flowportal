{
  "name": "itz-flow",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "test:auth": "playwright test --project=auth",
    "test:login": "playwright test tests/auth/login.spec.ts",
    "test:signout": "playwright test tests/auth/signout.spec.ts",
    "test:theme": "playwright test tests/theme",
    "test:workspace": "playwright test tests/workspace",
    "test:project": "playwright test tests/project",
    "test:my-work": "playwright test tests/my-work",
    "reports": "start \"\" reports\\index.html",
    "cases:csv": "node scripts/export-test-cases.js",
    "cases:check": "node scripts/export-test-cases.js --check",
    "typecheck": "tsc --noEmit -p .",
    "test:smoke": "node scripts/run-regression.js --priority High",
    "test:regression": "node scripts/run-regression.js",
    "module:new": "node scripts/new-module.js",
    "signoff": "node scripts/signoff.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{config,pages,components,fixtures,api,test-data,utils,tests,reporters}/**/*.ts\" playwright.config.ts eslint.config.mjs",
    "format:check": "prettier --check \"{config,pages,components,fixtures,api,test-data,utils,tests,reporters}/**/*.ts\" playwright.config.ts eslint.config.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run cases:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.10.1",
    "typescript": ">=6.0.0 <6.1.0",
    "typescript-eslint": "^8.73.0"
  }
}
